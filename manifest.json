{
  "manifest_version": 3,
  "name": "Alaxee Proxy",
  "short_name": "Alaxee Proxy",
  "version": "0.2.0",
  "description": "轻量的 Edge 代理控制器：将浏览器指向你自己运行的 HTTP 或 SOCKS5 服务器，支持直连白名单与强制代理黑名单。",
  "permissions": [
    "proxy",
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "Alaxee Proxy",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/status/proxy16.png",
      "32": "icons/status/proxy32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "optional_permissions": [
    "tabs"
  ]
}
